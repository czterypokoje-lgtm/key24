    "canonical": true,
    "hreflang": true,
    "sitemap": true,
    "robots": true
  },
  "tests": {
    "viewports": [
      320,
      390,
      768,
      1024,
      1280,
      1440
    ],
    "checks": [
      "typecheck",
      "lint",
      "build",
      "playwright",
      "keyboard",
      "reduced-motion",
      "no-broken-links",
      "crm-form",
      "customer-proof-gate",
      "i18n",
      "legal"
    ]
